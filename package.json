{
  "name": "zotero-llm-summarizer",
  "type": "module",
  "version": "0.1.5",
  "description": "Zotero 7+ plugin: one-click AI literature summarization for PDF attachments, saved as child notes.",
  "private": true,
  "author": "Zotero LLM Summarizer contributors",
  "license": "AGPL-3.0-or-later",
  "config": {
    "addonName": "Zotero LLM Summarizer",
    "addonID": "llm-summarizer@yourdomain.org",
    "addonRef": "llmsummarizer",
    "addonInstance": "LLMSummarizer",
    "prefsPrefix": "extensions.zotero.llmsummarizer",
    "updateURL": "https://github.com/yellow-queer/zotero-LLM_summerize/releases/latest/download/updates.json",
    "strictMaxVersion": "*"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=build/selftest.mjs --log-level=warning && node build/selftest.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0"
  }
}
